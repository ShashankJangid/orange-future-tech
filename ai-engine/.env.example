# Orange Future Tech Autonomous AI Engine Configuration

# Gemini / Antigravity AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Real-Time Alert Bot (Owner Notifications)
# Get token from Telegram @BotFather and your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Outreach Credentials (Resend / SMTP)
RESEND_API_KEY=re_123456789_your_key_here
SENDER_EMAIL=teams@orangefuturetech.com

# Social Media Marketing Graph APIs
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Cloud Master Audit Log (Supabase / PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
